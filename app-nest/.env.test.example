# Environment for the Supertest e2e suite (`pnpm --filter ./app-nest test:e2e`).
# Copy to `.env.test` and point DATABASE_URL at a THROWAWAY database — the suite
# TRUNCATEs every table between tests.

# Dedicated e2e database — the name must contain "test". Create it once
# (`createdb pharmacy_catalog_test` or via your Postgres client); the test
# runner's global setup applies migrations automatically.
DATABASE_URL="postgresql://postgres:root@localhost:5432/pharmacy_catalog_test?schema=public"

# Any non-placeholder value works — e2e never runs with NODE_ENV=production.
JWT_SECRET=e2e-test-secret-do-not-use-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Checkout minimum — keep at 0 so fixtures don't have to clear a threshold.
MIN_ORDER_TOTAL=0

# Login rate limit. Kept high so ordinary e2e tests never trip it; the
# dedicated throttling test lowers it in-process.
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
