# Application
PORT=3300

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5174,http://localhost:4200

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:root@localhost:5432/pharmacy_catalog?schema=public"

# JWT — generate strong secrets with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_EXPIRES_IN=1h

# Minimum order total (USD) enforced at checkout. 0 = disabled for the demo.
MIN_ORDER_TOTAL=0
