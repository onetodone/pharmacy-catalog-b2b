# Copy to `.env` and adjust. Only VITE_-prefixed vars reach the client bundle,
# and they are inlined at build time — rebuild after changing them.

# API base URL. Leave unset for the default `/api` (same origin as the SPA,
# proxied to the API by the dev server / a reverse proxy in production).
# Set an absolute URL only when the API lives on a different origin
# (then the API must allow CORS for the SPA origin).
# VITE_API_URL=https://api.example.com/api

# Uploaded-asset base URL. Defaults to `/uploads`.
# VITE_ASSETS_URL=https://api.example.com/uploads

# Dev only: where `vite dev` proxies `/api` and `/uploads`.
# Defaults to http://localhost:3300 (see app-nest/.env PORT).
# VITE_DEV_API_PROXY=http://localhost:3300
